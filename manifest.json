{
  "manifest_version": 3,
  "name": "KoalaSnap - 考拉易截",
  "version": "1.0.1",
  "description": "强大的截图工具，支持可见区域、整页滚动和区域选择三种截图模式 | Powerful screenshot tool with visible area, full-page, and area selection modes",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "KoalaSnap - 考拉易截"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "capture-visible": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "快速截取可见区域"
    }
  }
}